generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Camping {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?

  managers    CampingManager[]
  spots       Spot[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Spot {
  id              String   @id @default(cuid())
  campingId       String

  name            String
  description     String
  capacity        Int
  pricePerNight   Int
  imageUrl        String
  size            Int
  electricity     Boolean
  waterConnection Boolean

  camping         Camping  @relation(fields: [campingId], references: [id])
  features        SpotFeature[]
  reservations    Reservation[]
}

model SpotFeature {
  id     String @id @default(cuid())
  name   String

  spotId String
  spot   Spot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Reservation {
  id            String              @id @default(cuid())
  spotId        String
  spot          Spot                @relation(fields: [spotId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  email         String
  phone         String
  guests        Int
  arrivalDate   DateTime
  departureDate DateTime
  notes         String?
  status        ReservationStatus   @default(PENDING)
  createdAt     DateTime            @default(now())
}

model NewsItem {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  content   String
  date      DateTime
  imageUrl  String
}

enum ContactMessageStatus {
  NEW
  READ
  CLOSED
}

model ContactMessage {
  id        String                @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactMessageStatus  @default(NEW)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}


model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String
}

enum UserRole {
  ADMIN
  CUSTOMER
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)

  managedCampings CampingManager[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CampingManager {
  userId    String
  campingId String

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  camping   Camping @relation(fields: [campingId], references: [id], onDelete: Cascade)

  @@id([userId, campingId])
}